# ─── Backend Environment Variables (SECRETS) ───
# These must ONLY live on the server. NEVER commit real values.

NODE_ENV=production
PORT=4000

# ── Auth ──
JWT_SECRET=            # REQUIRED — generate with: openssl rand -hex 32
COOKIE_DOMAIN=faithhaven.amarktai.com

# ── CORS ──
CORS_ORIGIN=https://faithhaven.amarktai.com

# ── Rate limiting ──
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
RESET_TOKEN_TTL_MINUTES=30
VERIFY_TOKEN_TTL_HOURS=24

# ── Database ──
DATABASE_URL=postgresql://faithhaven:CHANGE_ME@db:5432/faithhaven

# ── OpenAI (optional — fallback to KJV Bible verses when absent) ──
OPENAI_API_KEY=

# ── PayFast ──
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_ENDPOINT=https://www.payfast.co.za/eng/process
PAYFAST_RETURN_URL=https://faithhaven.amarktai.com/payment/success
PAYFAST_CANCEL_URL=https://faithhaven.amarktai.com/payment/cancel
PAYFAST_NOTIFY_URL=https://faithhaven.amarktai.com/api/payfast/itn
PAYFAST_IP_WHITELIST=

# ── Postgres password (used by docker-compose) ──
POSTGRES_PASSWORD=     # REQUIRED — generate with: openssl rand -hex 16
